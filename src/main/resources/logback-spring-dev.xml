<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="HOST" source="spring.rabbitmq.host"/>
    <springProperty scope="context" name="PORT" source="spring.rabbitmq.port"/>
    <springProperty scope="context" name="USER" source="spring.rabbitmq.username"/>
    <springProperty scope="context" name="PASS" source="spring.rabbitmq.password"/>
    <springProperty scope="context" name="NAME" source="app.name"/>
    <springProperty scope="context" name="EXECUTION" source="proof.worker.workflow.executionId"/>

    <!-- Shared AMQP connection and routing properties -->
    <property name="AMQP_ROUTING_KEY" value="logs.block.${NAME}.execution.${EXECUTION}"/>
    <property name="AMQP_EXCHANGE" value="logs"/>
    <property name="AMQP_EXCHANGE_TYPE" value="topic"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="edu.kit.iai.webis.proofutils.logging.MDCValueFilter">
            <key>simplifiedFormat</key>
            <value>true</value>
            <acceptOnMatch>false</acceptOnMatch>
        </filter>
        <encoder>
            <pattern>
                %cyan([%date{"yyyy-MM-dd'T'HH:mm:ss.SSS",UTC}])-%highlight([%-6p])-%blue([%-15.-15c{0}])-%cyan([%-10.-10t{0}]) -- %msg%n
            </pattern>
        </encoder>
    </appender>
    <appender name="CONSOLE-MODEL" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="edu.kit.iai.webis.proofutils.logging.MDCValueFilter">
            <key>simplifiedFormat</key>
            <value>true</value>
            <acceptOnMatch>true</acceptOnMatch>
        </filter>
        <encoder>
            <pattern>
                %msg%n
            </pattern>
        </encoder>
    </appender>
    <!-- AMQP appender for normal Java logs: includes header, excludes simplified/model-forwarded lines -->
    <appender name="AMQP" class="org.springframework.amqp.rabbit.logback.AmqpAppender">
        <filter class="edu.kit.iai.webis.proofutils.logging.MDCValueFilter">
            <key>simplifiedFormat</key>
            <value>true</value>
            <acceptOnMatch>false</acceptOnMatch>
        </filter>
        <layout>
            <pattern><![CDATA[%d %p %t [%c] - <%m>%n]]></pattern>
        </layout>
        <host>${HOST}</host>
        <port>${PORT}</port>
        <username>${USER}</username>
        <password>${PASS}</password>
        <applicationId>${NAME}</applicationId>
        <routingKeyPattern>${AMQP_ROUTING_KEY}</routingKeyPattern>
        <exchangeName>${AMQP_EXCHANGE}</exchangeName>
        <exchangeType>${AMQP_EXCHANGE_TYPE}</exchangeType>
        <declareExchange>true</declareExchange>
        <generateId>true</generateId>
        <charset>UTF-8</charset>
        <durable>true</durable>
        <deliveryMode>PERSISTENT</deliveryMode>
    </appender>
    <!-- AMQP appender for model-forwarded lines: Java receive timestamp + bare message, mirrors CONSOLE-MODEL appender -->
    <appender name="AMQP-MODEL" class="org.springframework.amqp.rabbit.logback.AmqpAppender">
        <filter class="edu.kit.iai.webis.proofutils.logging.MDCValueFilter">
            <key>simplifiedFormat</key>
            <value>true</value>
            <acceptOnMatch>true</acceptOnMatch>
        </filter>
        <layout>
            <pattern><![CDATA[[%d{"yyyy-MM-dd'T'HH:mm:ss.SSS",UTC}] %m%n]]></pattern>
        </layout>
        <host>${HOST}</host>
        <port>${PORT}</port>
        <username>${USER}</username>
        <password>${PASS}</password>
        <applicationId>${NAME}</applicationId>
        <routingKeyPattern>${AMQP_ROUTING_KEY}</routingKeyPattern>
        <exchangeName>${AMQP_EXCHANGE}</exchangeName>
        <exchangeType>${AMQP_EXCHANGE_TYPE}</exchangeType>
        <declareExchange>true</declareExchange>
        <generateId>true</generateId>
        <charset>UTF-8</charset>
        <durable>true</durable>
        <deliveryMode>PERSISTENT</deliveryMode>
    </appender>
    <root level="info">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="CONSOLE-MODEL"/>
        <appender-ref ref="AMQP"/>
        <appender-ref ref="AMQP-MODEL"/>
    </root>
</configuration>
